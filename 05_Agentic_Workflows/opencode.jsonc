{
  "$schema": "https://opencode.ai/config.json",

  // Project-scoped MCP server for Session 05. opencode merges this with your
  // global ~/.config/opencode/opencode.jsonc, so the ALCF Inference provider
  // that `alcf-ai agent configure opencode` wrote there stays in effect --
  // this file only adds the "mcp" key.
  //
  // The server runs from the repo virtual environment built by ../setup.sh.
  // The relative paths resolve against the directory you start opencode in,
  // so start it from HERE.
  "mcp": {
    // One server, eleven tools: the ALCF Knowledge base (documentation),
    // four Globus staging tools, and six IRI calls. The IRI and Globus tools
    // need a valid token -- check with `alcf-tokens test-token iri`. The
    // documentation tool does not, so it answers even before you log in.
    "alcf-iri": {
      "type": "local",
      "command": ["../.venv/bin/python", "alcf_mcp.py"],
      "enabled": true,
      // Default is 5000 ms. The server starts in well under a second, but a
      // documentation call still has to reach ask.alcf.anl.gov.
      "timeout": 30000
    }
  }
}
